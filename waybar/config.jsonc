{
  "layer": "top",
  "position": "top",
  "height": 56,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces", "hyprland/submap"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["group/status"],
  "hyprland/window": {
    "max-length": 50,
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
  },
  "battery": {
    "interval": 40,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon}",
    "tooltip-format": "{capacity}% - {time}",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
    },
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": "",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "exec ghostty --title=bluetuith -e bluetuith",
  },
  "group/status": {
    "orientation": "horizontal",
    "modules": ["pulseaudio/slider", "battery", "bluetooth"],
  },
}
